doctype html
head
	meta(charset="UTF-8")
	meta(http-equiv="X-UA-Compatible" content="IE=edge")
	title KeyControl
	if combine
		style: include style.css
		script: include script.js
	else
		link(rel="stylesheet" href="style.css")
		script(src="script.js")
nav
	a(href="#hotkeys") Hotkeys
	a(href="#advancedkeys") Advanced Keys
	a(href="#games") Games
	a(href="#hotstrings") Hotstrings
	a(href="#inline") Inline
	//a(href="#naminghelper") Namer
	.spacer
	a(href="#technical") Technical
	a(href="#test") Test Area 
		sub 🛈
main
	#hotkeys
		.shiftInfo
			| Use
			span.keycombo Shift
			| to use Window under Cursor instead of focused Window
		table
			tr.title
				td Mouse
			tr
				td Move Window
				td.keycombo Ctrl+Win+Left Click
			tr
				td Resize Window
				td.keycombo Ctrl+Win+Right Click
			tr
				td Transparency
				td.keycombo Ctrl+Win+ScrollWheel
			tr
				td Scroll modifier 
					sub (best: 1,3,5,15,17,51,85,255)
				td
					input.byte(name="TransparencySpeed")
			tr.title
				td Windows
			tr
				td Get color under Cursor RGB
				td.keycombo Ctrl+Win+C
			tr
				td Copy color under Cursor RGB
				td.keycombo Ctrl+Win+Alt+C
			tr
				td Fullscreen (Borderless)
				td.keycombo Ctrl+Win+F
			tr
				td Fullscreen (Maximize)
				td.keycombo Ctrl+Win+Alt+F
			tr
				td Always on top
				td.keycombo Ctrl+Win+T
			tr
				td Borderless
				td.keycombo Ctrl+Win+B
			tr
				td Clickthrough
				td.keycombo Ctrl+Win+H
			tr
				td Set transparent color 
					sub(title="Doesn't work well with some windows") 🛈
				td.keycombo Ctrl+Win+X
			tr
				td Hide window
				td.keycombo Ctrl+Win+M
			tr
				td Unhide window
				td.keycombo Ctrl+Win+N
			tr.title
				td Others
			tr
				td Pause Video
				td.keycombo Pause
			tr
				td Kill KeyControl
				td.keycombo Ctrl+Win+Esc
			tr
				td Google selected text
				td.keycombo Ctrl+Win+G
			tr
				td Keep key down 
					sub(title="Press this Combo, then press all the keys, that should be held down, simultaneously.\nTo cancel a pressed key, just press the key again") 🛈
				td.keycombo Ctrl+Win+K
	#advancedkeys
		table
			tr.title
				td CapsLock
			tr
				td Open Settings Window
				td.keycombo Win+CapsLock
			tr
				td Toggle CapsLock 
					sub (Only for enabling)
				td.keycombo Ctrl+CapsLock | Shift+CapsLock
			tr
				td Override CapsLock
				td
					.check.box(name="CapsLock.Override")
			tr
				td Replacement
				td
					textarea(name="CapsLock.Advanced")
			tr.title
				td Spammer
			tr
				td Enable Spammer
				td
					.check.box(name="Spammer.Enabled")
			tr
				td Key combo
				td.keycombo ScrollLock
			tr
				td Delay in ms
				td
					input.int(name="Spammer.Delay")
			tr
				td Action
				td
					textarea(name="Spammer.Advanced")
			tr
				td Press
					span.keycombo Return
					| afterwards
				td
					.check.box(name="Spammer.Return")
			tr.title
				td Move Windows
			tr
				td Enable Move Windows
				td
					.check.box(name="MoveWindows.Enabled")
			tr
				td Key combo
				td.keycombo F1
			tr
				td Normal F1
				td.keycombo Win+F1
			tr
				td Maximize Windows when moving
				td
					.check.box(name="MoveWindows.Maximize")
	#games
		table
			tr.title
				td CrossHair
			tr
				td Enabled
				td
					.check.box(name="Games.CrossHair.Enabled")
			tr
				td Toggle CrossHair
				td.keycombo Ctrl+Win+V
			tr
				td Auto Enable in CSGO
				td
					.check.box(name="Games.CrossHair.AutoEnableInCsGo")
			tr
				td Line Color
				td
					input.color(name="Games.CrossHair.LineColor")
			tr
				td Line Gap
				td
					input.int(name="Games.CrossHair.LineGap")
			tr
				td Line Length
				td
					input.int(name="Games.CrossHair.LineLength")
			tr
				td Line Width
				td
					input.int(name="Games.CrossHair.LineWidth")
			tr
				td Center Dot
				td
					.check.box(name="Games.CrossHair.CenterDot")
			tr.title
				td Walking Direction
			tr
				td Enabled
				td
					.check.box(name="Games.Wasd.Enabled")
			tr
				td Direction
				td
					table.direction
						tr
							td
								.check.box(name="Games.Wasd.Direction=7")
							td
								.check.box(name="Games.Wasd.Direction=0")
							td
								.check.box(name="Games.Wasd.Direction=1")
						tr
							td
								.check.box(name="Games.Wasd.Direction=6")
							td

							td
								.check.box(name="Games.Wasd.Direction=2")
						tr
							td
								.check.box(name="Games.Wasd.Direction=5")
							td
								.check.box(name="Games.Wasd.Direction=4")
							td
								.check.box(name="Games.Wasd.Direction=3")
	#hotstrings(name="HotStrings")
	#inline
		table
			tr.title
				td Calculate
			tr
				td Calculate Selection
				td.keycombo NumLock
			tr
				td Toggle NumLock
				td.keycombo Shift+NumLock
			tr
				td Hotstring
				td
					span.hotstring
						| @=
						i expression
						| ⏎
			tr
				td Calculate Now
				td
					textarea#calc.now
			tr
				td
				td
					textarea(name="calc", readonly)
			tr.title
				td Flip Upside Down
			tr
				td Hotstring
				td
					span.hotstring
						| @flip 
						i text
						| ⏎
			tr
				td Flip Now
				td
					textarea(name="flip1")
			tr
				td
				td
					textarea(name="flip2")
			tr.title
				td Unicode
			tr
				td Any Unicode
				td
					span.hotstring
						| @u+
						i code
						| ⏎
			tr
				td 4 Digit Unicode
				td
					span.hotstring
						| @u
						i code
			//tr
			//	td 8 Digit Unicode
			//	td
			//		span.hotstring
			//			| @U
			//			i code
			tr
				td Convert Now (\u???? ⇌ �)
				td
					textarea(name="unicode1")
			tr
				td
				td
					textarea(name="unicode2")
			tr.title
				td Number Converter
			tr
				td HotStrings
				td(style="line-height:1.5em")
					span.hotstring
						| @
						b [bdh]
						b [bdh]
						i number
						| ⏎
					br
					| e.g. binary to hex:
					span.hotstring
						| @bh
						i number
						| ⏎
			tr
				td Convert Now: BIN 
					sub (Base 2)
				td
					textarea(name="convertBin")
			tr
				td Convert Now: DEC 
					sub (Base 10)
				td
					textarea(name="convertDec")
			tr
				td Convert Now: HEX 
					sub (Base 16)
				td
					textarea(name="convertHex")

	//#naminghelper
		table
			tr.title
				td Naming Helper
			tr
				td Enable Naming Helper
				td
					.check.box(name="NamingHelper.Enabled")
			tr
				td Key combo
				td.keycombo Right-Ctrl
			tr
				td Select text before (
					span.keycombo Ctrl+A
					| )
				td
					.check.box(name="NamingHelper.SelectAll")
			tr
				td Text before
				td
					textarea(name="NamingHelper.Pre")
			tr
				td Current index
				td
					input.long(name="NamingHelper.Index")
			tr
				td Text after
				td
					textarea(name="NamingHelper.Post")
			tr
				td Press
					span.keycombo Return
					| #{" "} afterwards
				td
					.check.box(name="NamingHelper.Enabled")
	#technical
		table
			tr
				td Quick-Emoji Timeout 
					sub(title=
					"When you want to write multiple Emojis you have to write the full HotString for the first,\n"+
					"but after that you can just write the last letter of any Emoji-HotString to write the Emoji.\n"+
					"Here you can specify the Timeout in ms for this action") 🛈
				td
					input.int(name="EmojiTimeout")
	//TODO add info about Advanced Actions ("Send" Class)
	textarea#test